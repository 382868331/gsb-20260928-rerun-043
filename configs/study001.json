{
  "batch_id": "STUDY-001",
  "name": "虚构慢病随访队列",
  "description": "完全虚构的演示研究资料，不接入任何医院系统。",
  "subject_field": "subject_id",
  "tables": ["demographics", "visits", "labs", "medications"],
  "rules": {
    "demographics": [
      {"field": "name", "action": "drop"},
      {"field": "id_card", "action": "drop"},
      {"field": "phone", "action": "drop"},
      {"field": "address", "action": "drop"},
      {"field": "birth_date", "action": "date_shift"},
      {"field": "note", "action": "redact_text"}
    ],
    "visits": [
      {"field": "visit_date", "action": "date_shift"},
      {"field": "chief_complaint", "action": "redact_text"}
    ],
    "labs": [
      {"field": "collected_at", "action": "date_shift"},
      {"field": "remark", "action": "redact_text"}
    ],
    "medications": [
      {"field": "note", "action": "redact_text"}
    ]
  }
}
